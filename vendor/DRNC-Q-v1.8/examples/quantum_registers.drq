%set[PC]
program quantum_registers;
# Register basis sectors are generated by the runtime, not typed as bit strings.
seed(20261022);
DRNCQ = "q", qregfonk(3);
assert(register_size(q) == 3, "three-qubit register expected");
hgate(q[0]);
cxgate(q[0], q[1]);
assert(abs(norm(q[0]) - 1.0) < 0.00000001, "Bell pair norm");
assert(abs(probabilities(q[0])[0] - 0.5) < 0.00000001, "|EVET,EVET,EVET> probability");
assert(abs(probabilities(q[0])[3] - 0.5) < 0.00000001, "correlated pair probability");
assert(abs(expectation_z(q[0])) < 0.00000001, "balanced qubit expectation");
assert(verify_entanglement(q[0], q[1]), "qubits 0/1 should be entangled");
toffoligate(q[0], q[1], q[2]);
assert(abs(probabilities(q[0])[0] - 0.5) < 0.00000001, "Toffoli leaves |000> amplitude");
assert(abs(probabilities(q[0])[7] - 0.5) < 0.00000001, "Toffoli maps |011> to |111>");
sgate(q[0]);
tgate(q[1]);
ygate(q[2]);
cphasegate(q[0], q[2], pi() / 3.0);
swapgate(q[1], q[2]);
assert(abs(norm(q[0]) - 1.0) < 0.00000001, "unitary gates preserve norm");
evrimfonk(q[0], 0.125);
assert(abs(norm(q[0]) - 1.0) < 0.00000001, "modular spectral evolution preserves norm");
print("indexed multi-qubit register PASS");
print(probabilities(q[0]));
print(moduleradim(0.0));
modular_status();
