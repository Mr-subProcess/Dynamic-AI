%set[QPC]
program drnc_reversible_parameterized;

// User-defined DRNC-Q operations infer angle and qubit parameters from gate use.
operation drncRZ(girdi theta, girdi target) {
    rzgate(target, theta);
}

operation drncPhaseEntangler(girdi phi, girdi control, girdi target) {
    drncRZ(phi, control);
    cxgate(control, target);
    rzgate(target, phi / 2);
}

operation drncTwoAngle(girdi theta, girdi phi, girdi target) {
    rzgate(target, theta);
    rxgate(target, phi);
}

// The state sectors and Bell pair are generated by DRNC-Q constructors.
DRNCQ = "psi", superposfonk(pi() / 4);
DRNCQ = "bell", donfonk();
DRNCQ = "branch", zeryafonk(psi);
DRNCQ = "work", qregfonk(2);

hgate(work[0]);
drncRZ(pi() / 3, work[0]);
drncPhaseEntangler(pi() / 2, work[0], work[1]);
controlledgate("drncRZ", work[1], [work[0]], pi() / 5);
adjointgate("drncRZ", pi() / 5, work[0]);
powergate("drncRZ", [work[0]], 2, pi() / 10);
powergate("drncRZ", [work[0]], -1, pi() / 10);
drncTwoAngle(pi() / 7, pi() / 9, work[0]);
controlledgate("drncTwoAngle", work[1], [work[0]], [pi() / 8, pi() / 11]);
adjointgate("drncTwoAngle", pi() / 8, pi() / 11, work[0]);
powergate("drncTwoAngle", [work[0]], 2, [pi() / 6, pi() / 7]);
powergate("drncTwoAngle", [work[0]], -1, [pi() / 6, pi() / 7]);

evrimfonk(psi, 0.125);
moduleradim(0.25);
DRNCQ = "branch_measure", measure_basis(branch, "Z");
if (branch_measure == "HAYIR") {
    xgate(psi);
} else {
    zgate(psi);
}
DRNCQ = "work_measurements", measure_all(work);
DRNCQ = "bell_measurements", measure_all(bell);
